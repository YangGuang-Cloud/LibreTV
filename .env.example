# 共享密码模式必填：访问密码（账号模式改用个人账号登录）
PASSWORD=change-me

# 服务器统一管理点播源：client 保留原网页自配置方式，server 为多客户端共用方式
SOURCE_MODE=client
EPISODE_METADATA_AUTO=true
# 后台管理必填：独立管理员密码，用于账号和共享点播源管理
# ADMIN_PASSWORD=change-this-admin-password
# 点播源首次从 DEFAULT_SOURCES 读取，管理员保存后以磁盘配置为准
# DEFAULT_SOURCES=[{"name":"示例源","url":"https://example.com/api.php/provide/vod"}]
# 配置及账号数据库持久化目录（默认 .data；服务器建议使用固定的绝对路径，更新应用时保留）
# SERVER_DATA_DIR=/var/lib/libretv

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可指定自己的 60s API 实例
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 登录方式：password 保留共享密码；account 开启管理员分配的个人账号（不开放注册）
AUTH_MODE=password
# 账号模式必填：站点的完整访问源地址，不含路径，例如 https://tv.example.com
# BETTER_AUTH_URL=https://tv.example.com
# 账号模式必填：至少 32 字符的随机密钥，生成后固定保存；修改将使已有会话失效
# 生成示例：openssl rand -hex 32
# BETTER_AUTH_SECRET=
# 账号、个人设置及跨设备记录保存为 SERVER_DATA_DIR/accounts.sqlite，请定期备份
# Bangumi 专用本机出站（可选，两项一起配置；凭据只放服务器私密环境文件）
# BANGUMI_HTTP_PROXY=http://username:password@127.0.0.1:18089
# BANGUMI_DNS_SERVER=127.0.0.1:18053

# 可选：管理员查看账号密码所用的独立 AES-256 密钥（64 位十六进制），不要与登录会话密钥共用。
# 不设置时在 SERVER_DATA_DIR/.account-password.key 自动生成，权限 0600，需单独妥善备份。
# 启用后不要直接修改或丢弃密钥，否则已有加密密码记录无法读取。
# ACCOUNT_PASSWORD_KEY=
